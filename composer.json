{
	"name": "saldanhakun/semantics",
	"description": "Definições semânticas para aplicações modernas",
	"keywords": [
		"symfony",
		"symfony7",
		"form",
		"constraints",
		"constraint",
		"validator",
		"validation",
		"data types"
	],
	"minimum-stability": "stable",
	"prefer-stable": true,
	"license": "MIT",
	"authors": [
		{
			"name": "Marcelo Saldanha",
			"email": "saldanha@uttara.com.br"
		}
	],
	"require": {
		"php": "^8.2",
		"symfony/validator": "^7.3",
		"symfony/form": "^7.3",
		"symfony/string": "^7.3"
	},
	"autoload": {
		"psr-4": {
			"Saldanhakun\\Semantics\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Saldanhakun\\Semantics\\Tests\\": "tests/"
		}
	},
	"require-dev": {
		"fakerphp/faker": "^1.24",
		"friendsofphp/php-cs-fixer": "^3.85",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5"
	},
	"scripts": {
		"phpstan": [
			"vendor/bin/phpstan analyse src/ --level=5"
		],
		"cs": [
			"vendor/bin/php-cs-fixer fix --dry-run --show-progress=bar --format=@auto,txt"
		],
		"csfix": [
			"vendor/bin/php-cs-fixer fix --show-progress=bar --format=@auto,txt"
		],
		"csdebug": "vendor/bin/php-cs-fixer fix --dry-run"
	}
}
